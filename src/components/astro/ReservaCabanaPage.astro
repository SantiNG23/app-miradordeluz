---
import Layout from "../../layouts/Layout.astro";
import NavbarMiradorDeLuz from "@components/layout/Navbar";
import FooterMiradorDeLuz from "@components/layout/Footer";
import CabanaGalleryGrid from "@components/domain/gallery/CabanaGalleryGrid";
import AmenitiesModal from "@components/common/AmenitiesModal";
import ReservaQuoteWidget from "@components/domain/booking/ReservaQuoteWidget";
import { IconUsers, IconBed, IconBath } from "@components/common/Icons";
import {
  getReservaCabanaConfig,
  getReservaCabanaImages,
  getServicios,
} from "@constants/reservasConfig";
import { cabanas } from "@constants/cabanas";
// Optimización de Logo
import { getImage } from "astro:assets";
import logoImage from "../../assets/logo-mirador-luz.webp";

const optimizedLogo = await getImage({
  src: logoImage,
  format: "webp",
  width: 120,
});

const { cabanaId } = Astro.props as { cabanaId: string };

const cabanaConfig = getReservaCabanaConfig(cabanaId);
if (!cabanaConfig) {
  return Astro.redirect("/");
}

const cabanaDetail = cabanas.find((c) => c.id === cabanaId);
const images = getReservaCabanaImages(cabanaId);

const cabana = {
  id: cabanaConfig.id,
  nombre: cabanaConfig.nombre,
  capacidad: cabanaConfig.capacidad,
  descripcion: cabanaDetail?.descripcion || "Disfrutá de una estadía inolvidable en nuestras cabañas totalmente equipadas.",
};

const pageTitle = `${cabana.nombre} - Mirador de Luz`;

const amenityTexts: Record<string, any> = {
  '1': {
    wifi: { title: "WiFi", desc: "Conexión a internet de alta velocidad." },
    kitchen: { title: "Cocina completa", desc: "Heladera bajo mesada, cocina con horno, vajilla completa y microondas." },
    grill: { title: "Asador privado", desc: "Parrilla individual." },
    tv: { title: 'Smart TV 32"', desc: "Incluye canales abiertos (TDA) y aplicaciones de streaming." },
    ac: { title: "Equipamiento adicional", desc: "Aire acondicionado frío/calor, ventilador de pie, ropa blanca y mosquiteros." },
    garage: { title: "Cochera", desc: "Semi cubierta, ubicada a la par de la cabaña." }
  },
  '2': {
    wifi: { title: "WiFi", desc: "Conexión a internet de alta velocidad." },
    kitchen: { title: "Cocina completa", desc: "Heladera con Freezer, cocina con horno, vajilla completa y microondas." },
    grill: { title: "Asador privado", desc: "Parrilla individual." },
    tv: { title: 'Smart TV 32"', desc: "Incluye canales abiertos (TDA) y aplicaciones de streaming." },
    ac: { title: "Equipamiento adicional", desc: "Aire acondicionado frío/calor, ventilador de pie, ropa blanca y mosquiteros." },
    garage: { title: "Cochera Cubierta", desc: "Protección para tu vehículo frente a cada cabaña." }
  },
  '3': {
    wifi: { title: "WiFi", desc: "Conexión a internet de alta velocidad." },
    kitchen: { title: "Cocina completa", desc: "Heladera bajo mesada, cocina con horno, vajilla completa y microondas." },
    grill: { title: "Asador privado", desc: "Parrilla individual." },
    tv: { title: 'Smart TV 32"', desc: "Incluye canales abiertos (TDA) y aplicaciones de streaming." },
    ac: { title: "Equipamiento adicional", desc: "Aire acondicionado frío/calor, ventilador de pie, ropa blanca y mosquiteros." },
    garage: { title: "Cochera", desc: "Semi cubierta, ubicada a la par de la cabaña." }
  },
  '4': {
    wifi: { title: "WiFi", desc: "Conexión a internet de alta velocidad." },
    kitchen: { title: "Cocina completa", desc: "Heladera con Freezer, cocina con horno, vajilla completa y microondas." },
    grill: { title: "Asador privado", desc: "Parrilla individual." },
    tv: { title: 'Smart TV 32"', desc: "Incluye canales abiertos (TDA) y aplicaciones de streaming." },
    ac: { title: "Equipamiento adicional", desc: "Aire acondicionado frío/calor, ventilador de pie, ropa blanca y mosquiteros." },
    garage: { title: "Cochera Cubierta", desc: "Protección para tu vehículo frente a cada cabaña." }
  },
  'default': {
    wifi: { title: "WiFi", desc: "Conexión estable en todo el complejo para tu trabajo o relax." },
    kitchen: { title: "Cocina completa", desc: "Heladera con freezer, horno, vajilla completa y cafetera." },
    grill: { title: "Asador privado", desc: "Parrilla individual en el deck de tu cabaña para tus asados." },
    tv: { title: 'Smart TV 32"', desc: "Entretenimiento garantizado con Youtube y Netflix disponibles." },
    ac: { title: "Aire Split F/C", desc: "Climatización perfecta durante todo el año (frío/calor)." },
    garage: { title: "Cochera Cubierta", desc: "Protección para tu vehículo frente a cada cabaña." }
  }
};

const currentAmenities = amenityTexts[cabana.id] || amenityTexts['default'];
---

<Layout
  title={pageTitle}
  description={cabana.descripcion}
>
  <NavbarMiradorDeLuz
    client:load
    variant="solid-navy"
    showReservaButton={false}
    logoSrc={optimizedLogo.src}
  />

  <main class="bg-gray-50 pt-20 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Botón Volver -->
      <div class="mb-4 md:mb-6">
        <a
          href={`/#${cabanaDetail?.slug || 'nuestras-cabanas'}`}
          class="inline-flex items-center gap-2 py-2 rounded-full text-sm font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 transition-all px-3 bg-white/50 backdrop-blur-sm shadow-sm border border-gray-100"
          aria-label="Volver al inicio"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Volver a Cabañas</span>
        </a>
      </div>
      
      <!-- HERO GALLERY (Airbnb Style) -->
      <div class="mb-12">
        <CabanaGalleryGrid 
          client:load 
          images={images} 
          cabanaName={cabana.nombre} 
          cabanaId={cabana.id}
        />
      </div>

      <!-- MAIN CONTENT LAYOUT (2 Columns) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 xl:gap-16 items-start">
        
        <!-- LEFT COLUMN (Info) -->
        <div class="lg:col-span-2 space-y-10">
          
          <!-- Title & Summary -->
          <section>
            <h1 
              class="text-3xl md:text-5xl font-montserrat font-bold text-slate-900 mb-6 tracking-tight"
              style={`view-transition-name: cabin-title-${cabana.id};`}
            >
              {cabana.nombre}
            </h1>
            
            <div class="flex flex-wrap gap-3 mb-8">
              <span class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-slate-700 text-sm font-semibold shadow-sm flex items-center gap-2">
                <IconUsers className="w-5 h-5 text-[#756341]" /> Hasta {cabana.capacidad} Personas
              </span>
              <span class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-slate-700 text-sm font-semibold shadow-sm flex items-center gap-2">
                <IconBed className="w-5 h-5 text-[#756341]" /> {cabana.id === '3' ? 'Monoambiente' : (cabana.id === '1' ? '1 Dormitorio' : '2 Dormitorios')}
              </span>
              <span class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-slate-700 text-sm font-semibold shadow-sm flex items-center gap-2">
                <IconBath className="w-5 h-5 text-[#756341]" /> 1 Baño
              </span>
            </div>

            <div class="prose prose-slate max-w-none">
              <p class="text-slate-600 text-lg leading-relaxed md:text-xl font-medium opacity-90">
                {cabana.descripcion}
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          <!-- Amenities -->
          <section>
            <h2 class="text-2xl md:text-3xl font-montserrat font-bold text-slate-900 mb-8 tracking-tight">
              Lo que ofrece este alojamiento
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-10 gap-x-12">
              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.wifi.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.wifi.desc}</p>
                </div>
              </div>

              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.kitchen.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.kitchen.desc}</p>
                </div>
              </div>

              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                   <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.5-7 3 3 3 6 1 9 3.5-2 5-3 5-3s1 1 1 2c0 1.5-1 4-1.5 5.5l1.657 1.657z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.grill.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.grill.desc}</p>
                </div>
              </div>

              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.tv.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.tv.desc}</p>
                </div>
              </div>

              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.ac.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.ac.desc}</p>
                </div>
              </div>

              <div class="flex items-start gap-5 group font-montserrat">
                <div class="w-14 h-14 rounded-2xl bg-slate-900 shrink-0 flex items-center justify-center text-white shadow-lg transition-transform group-hover:scale-110">
                   <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 text-lg">{currentAmenities.garage.title}</h3>
                  <p class="text-slate-600 leading-snug">{currentAmenities.garage.desc}</p>
                </div>
              </div>
            </div>
            
            <div class="mt-12">
               <AmenitiesModal 
                 client:visible 
                 amenities={getServicios(cabana.id)} 
                 cabaName={cabana.nombre} 
                 variant="button" 
               />
            </div>
          </section>

          <hr class="border-slate-200" />

          <!-- Módulo de Reserva para Mobile -->
          <div class="lg:hidden">
            <ReservaQuoteWidget
              client:load
              cabanaId={cabana.id}
              cabanaNombre={cabana.nombre}
              capacidad={cabana.capacidad}
              variant="mobile"
            />
          </div>

          <!-- Ubicación -->
          <section class="pb-8">
            <h2
              class="text-2xl md:text-3xl font-montserrat font-bold text-slate-900 mb-6 tracking-tight"
            >
              Cómo llegar
            </h2>
            <p class="text-slate-600 mb-6 text-lg font-montserrat">
              Estamos ubicados en <span class="font-bold text-slate-900"
                >Villa Santa Cruz del Lago</span
              >, en un punto estratégico para recorrer Punilla y a solo 10 minutos
              de Villa Carlos Paz.
            </p>
            <div
              class="aspect-video w-full rounded-3xl overflow-hidden shadow-2xl border border-white relative bg-white"
            >
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13619.6!2d-64.5224419!3d-31.3730543!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x942d65f0c8772fbd%3A0x4d7f1d8348462d0a!2sMirador%20de%20Luz!5e0!3m2!1ses!2sar!4v1702000000000!5m2!1ses!2sar"
                class="w-full h-full"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                title="Ubicación de Mirador de Luz en Google Maps"
              ></iframe>
            </div>
          </section>
        </div>

        <!-- RIGHT COLUMN (Reserva - Desktop Only) -->
        <aside class="hidden lg:block relative h-full">
          <div class="lg:sticky lg:top-32 pb-12">
            <ReservaQuoteWidget
              client:load
              cabanaId={cabana.id}
              cabanaNombre={cabana.nombre}
              capacidad={cabana.capacidad}
              variant="desktop"
            />
          </div>
        </aside>

      </div>
    </div>
  </main>

  <FooterMiradorDeLuz client:idle logoSrc={optimizedLogo.src} />
</Layout>


